 (name spec)
 (modules spec)
 (libraries unix))

(library
 (name heartbeat)
 (modules heartbeat)
 (libraries unix))

; card S3a: the durable run-record store that replaces the S2 jsonl stub.
(library
 (name store)
 (modules store)
 (libraries spec unix))

; card S3b: the outbox shipper - the duplicate-ACK ship loop.
(library
 (name outbox)
 (modules outbox))

(executable
 (name pp_cron)
 (modules pp_cron)
 (libraries spec store outbox unix))

(test
 (name test_spec)
 (modules test_spec)
 (libraries spec unix))

(test
 (name store_test)
 (modules store_test)
 (libraries spec store unix))

(test
 (name heartbeat_test)
 (modules heartbeat_test)
 (libraries heartbeat unix))

(test
 (name outbox_test)
 (modules outbox_test)
 (libraries outbox unix))

; card a88d99 asks for the daemon-side binary to be named pp-cron.exe.
(rule
 (targets pp-cron.exe)
 (deps pp_cron.exe)
 (action
  (copy %{dep:pp_cron.exe} %{targets})))

; card 43a6c99d, P1/P2: the node connector - the doorbell (webhook) and
; the static-mesh wireguard key authority.
(library
 (name node_connector)
 (modules node_connector)
 (libraries spec unix))

(executable
 (name pp_node)
 (modules pp_node)
 (libraries node_connector spec unix))

; card 43a6c99d: the three acceptance tests for the node connector, wired
; into `dune runtest` so the doorbell, the key authority and the tier law
; are exercised by the build itself.
(rule
 (alias runtest)
 (deps tests/webhook_receiver.sh DECISIONS.md pp_node.exe)
 (action (run sh %{dep:tests/webhook_receiver.sh})))

(rule
 (alias runtest)
 (deps tests/peer_mint.sh DECISIONS.md pp_node.exe)
 (action (run sh %{dep:tests/peer_mint.sh})))

(rule
 (alias runtest)
 (deps tests/peer_tier.sh DECISIONS.md pp_node.exe)
 (action (run sh %{dep:tests/peer_tier.sh})))

(alias
 (name default)
 (deps pp-cron.exe pp_node.exe))
